# Copy this file to .env.local for local development (Next.js reads it automatically).
# On Cloudflare, set each value with:  npx wrangler secret put NAME   (public values may go in wrangler.jsonc "vars").
# Never commit real values. Every setting except the first three is optional: a missing one simply switches that
# connection off, and Admin > Integrations shows what is still missing.

# ---------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------

# Supabase Postgres. Supabase dashboard > Connect > "Transaction pooler" string (port 6543). Replace the password.
# Locally you can use the embedded database started by `npm run db:dev`:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/lakshmi
DATABASE_URL=

# Signs the admin sign-in cookie. A long random string (32+ characters), e.g. from:  openssl rand -base64 48
SESSION_SECRET=

# The public address of the website, no trailing slash. Used in the sitemap, social previews and the links
# inside patient messages. (If left empty the address of the current request is used.)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------------------------------------------------------------------------------------------------------------
# First admin sign-in (only used while there are no admin accounts yet)
# ---------------------------------------------------------------------------------------------------------------
# The first time someone signs in with exactly these values, an OWNER account is created with that username and a
# hashed copy of the password. After that these two settings are ignored: manage accounts in Admin > Admin accounts.
# Use a password of 10+ characters with letters and numbers, then remove both settings.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API): booking messages and reminders to patients
# ---------------------------------------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# One approved template name per event (see Admin > Integrations for the variables each template receives).
# Without a name the plain text is sent, which WhatsApp only delivers inside a patient's 24-hour window.
WHATSAPP_TEMPLATE_BOOKING_PENDING=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_DATE_UNAVAILABLE=
WHATSAPP_TEMPLATE_THANK_YOU=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_ADMIN_ALERT=
# Staff alerts (new booking, cancellation, blocked date): a WhatsApp number (digits with country code) and/or an email.
ADMIN_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------------------------------------------
# Email (Resend): staff alerts by email
# ---------------------------------------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Clinic <notifications@your-domain.example>
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------------------------------------------
# Photos (Supabase Storage). Create a PUBLIC bucket named "clinic-media" (or set the name below).
# Without these, photo upload is switched off on Cloudflare and saves to public/uploads locally.
# ---------------------------------------------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clinic-media

# ---------------------------------------------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile). Create a widget in the Cloudflare dashboard. Both keys switch it on.
# ---------------------------------------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Reminders. The scheduled job calls /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
# ---------------------------------------------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Optional: exact clinic coordinates for the map (otherwise the saved address is used)
# ---------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_CLINIC_LAT=
NEXT_PUBLIC_CLINIC_LNG=
